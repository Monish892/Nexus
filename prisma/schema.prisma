generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  profile      Profile?
  sessions     Session[]
  auditLogs    AuditLog[]
  repositories Repository[]
  scores       DeveloperScore[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Repository {
  id          String             @id @default(cuid())
  userId      String
  githubId    Int
  owner       String
  name        String
  fullName    String
  url         String
  description String?
  primaryLanguage String?
  stars       Int                @default(0)
  forks       Int                @default(0)
  isPrivate   Boolean            @default(false)
  languages   Json?
  analyzedAt  DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    RepositoryAnalysis[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([userId, githubId])
  @@index([userId, updatedAt])
}

model RepositoryAnalysis {
  id           String   @id @default(cuid())
  repositoryId String
  status       AnalysisStatus @default(COMPLETED)
  summary      String
  signals      Json
  scores       Json
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([repositoryId, createdAt])
}

model DeveloperScore {
  id        String   @id @default(cuid())
  userId    String
  overall   Int
  breakdown Json
  evidence  Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Profile {
  id String @id @default(cuid())
  userId String @unique
  name String?
  headline String?
  bio String?
  location String?
  yearsExperience Int?
  targetRole String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

enum Role {
  USER
  ADMIN
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
