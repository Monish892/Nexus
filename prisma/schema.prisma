generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  profile      Profile?
  sessions     Session[]
  auditLogs    AuditLog[]
  repositories Repository[]
  scores       DeveloperScore[]
  
  githubAccount  GitHubAccount?
  projects       Project[]
  skills         Skill[]
  resumes        Resume[]
  conversations  AIConversation[]
  interviews     Interview[]
  codingSubs     CodingSubmission[]
  roadmaps       Roadmap[]
  notifications  Notification[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GitHubAccount {
  id            String    @id @default(cuid())
  userId        String    @unique
  githubId      Int       @unique
  username      String
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Repository {
  id          String             @id @default(cuid())
  userId      String
  githubId    Int
  owner       String
  name        String
  fullName    String
  url         String
  description String?
  primaryLanguage String?
  stars       Int                @default(0)
  forks       Int                @default(0)
  isPrivate   Boolean            @default(false)
  languages   Json?
  analyzedAt  DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    RepositoryAnalysis[]
  repoLanguages RepositoryLanguage[]
  activities  RepositoryActivity[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([userId, githubId])
  @@index([userId, updatedAt])
}

model RepositoryLanguage {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  bytes        Int
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryActivity {
  id           String   @id @default(cuid())
  repositoryId String
  type         String
  count        Int
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryAnalysis {
  id           String   @id @default(cuid())
  repositoryId String
  status       AnalysisStatus @default(COMPLETED)
  summary      String
  signals      Json
  scores       Json
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  @@index([repositoryId, createdAt])
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  url         String?
  sourceUrl   String?
  technologies String[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    ProjectAnalysis[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectAnalysis {
  id        String   @id @default(cuid())
  projectId String
  status    AnalysisStatus @default(COMPLETED)
  summary   String
  signals   Json
  scores    Json
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DeveloperScore {
  id        String   @id @default(cuid())
  userId    String
  overall   Int
  breakdown Json
  evidence  Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  domain    String?
  score     Int      @default(0)
  evidence  SkillEvidence[]
  assessments SkillAssessment[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, name])
}

model SkillEvidence {
  id          String   @id @default(cuid())
  skillId     String
  type        String
  sourceId    String
  description String
  confidence  Float
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model SkillAssessment {
  id        String   @id @default(cuid())
  skillId   String
  score     Int
  passed    Boolean
  details   Json?
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Profile {
  id String @id @default(cuid())
  userId String @unique
  name String?
  headline String?
  bio String?
  location String?
  yearsExperience Int?
  targetRole String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String
  fileUrl   String
  isPrimary Boolean  @default(false)
  versions  ResumeVersion[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  version   Int
  parsedData Json?
  analysis  ResumeAnalysis?
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  resumeVersionId String   @unique
  atsScore        Int
  keywords        String[]
  missingKeywords String[]
  feedback        Json
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model JobDescription {
  id              String   @id @default(cuid())
  userId          String?
  title           String
  company         String?
  content         String
  parsedData      Json?
  matches         JobMatch[]
  createdAt       DateTime @default(now())
}

model JobMatch {
  id               String   @id @default(cuid())
  jobDescriptionId String
  userId           String
  overallScore     Int
  skillGaps        SkillGap[]
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model SkillGap {
  id         String   @id @default(cuid())
  jobMatchId String
  skillName  String
  importance String 
  jobMatch   JobMatch @relation(fields: [jobMatchId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  type      String   
  sourceId  String
  chunks    DocumentChunk[]
  createdAt DateTime @default(now())
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  metadata   EmbeddingMetadata?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model EmbeddingMetadata {
  id              String   @id @default(cuid())
  documentChunkId String   @unique
  vectorId        String   
  documentChunk   DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  messages  AIMessage[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   
  content        String
  aiConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model AgentExecution {
  id        String   @id @default(cuid())
  userId    String
  agentType String
  status    AnalysisStatus
  input     Json
  output    Json?
  error     String?
  createdAt DateTime @default(now())
}

model Interview {
  id          String   @id @default(cuid())
  userId      String
  type        String
  status      AnalysisStatus @default(QUEUED)
  questions   InterviewQuestion[]
  evaluation  InterviewEvaluation?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InterviewQuestion {
  id          String   @id @default(cuid())
  interviewId String
  content     String
  order       Int
  answer      InterviewAnswer?
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model InterviewAnswer {
  id                  String   @id @default(cuid())
  interviewQuestionId String   @unique
  content             String
  score               Int?
  feedback            String?
  interviewQuestion   InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model InterviewEvaluation {
  id          String   @id @default(cuid())
  interviewId String   @unique
  overallScore Int
  strengths   String[]
  weaknesses  String[]
  feedback    String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model CodingChallenge {
  id          String   @id @default(cuid())
  title       String
  description String
  language    String
  template    String
  testCases   Json
  submissions CodingSubmission[]
}

model CodingSubmission {
  id                String   @id @default(cuid())
  codingChallengeId String
  userId            String
  code              String
  status            AnalysisStatus
  evaluations       CodeEvaluation[]
  codingChallenge   CodingChallenge @relation(fields: [codingChallengeId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model CodeEvaluation {
  id                 String   @id @default(cuid())
  codingSubmissionId String
  passed             Boolean
  executionTimeMs    Int?
  feedback           String
  codingSubmission   CodingSubmission @relation(fields: [codingSubmissionId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id        String   @id @default(cuid())
  userId    String
  targetRole String
  items     RoadmapItem[]
  progress  RoadmapProgress[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoadmapItem {
  id        String   @id @default(cuid())
  roadmapId String
  title     String
  description String
  priority  Int
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model RoadmapProgress {
  id        String   @id @default(cuid())
  roadmapId String
  itemId    String
  status    String 
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
